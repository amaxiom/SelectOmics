{
    "data_path": "GBM_miRNA_input.csv",
    "target_column": "Label",
    "schema_version": "1.0",
    "input_format": "auto",
    "hdf5_key": "data",
    "excel_sheet_name": 0,
    "output_dir": "GBM_results_miRNA",
    "output_format": "csv",
    "excel_output_engine": "openpyxl",
    "save_intermediate_results": true,
    "create_visualizations": true,
    "plot_format": "png",
    "verbose": true,
    "algorithm": "XGB",
    "n_consensus_models": 5,
    "random_seed": 42,
    "test_size": 0.25,
    "cv_splits": 5,
    "min_cv_splits": 3,
    "max_cv_splits": 20,
    "quick_tune_iterations": 30,
    "use_gpu": true,
    "enable_step1": true,
    "enable_step2": true,
    "enable_step3": true,
    "enable_step4": true,
    "enable_step_evaluations": true,
    "enable_final_importance_analysis": true,
    "enable_final_test_evaluation": true,
    "max_variance_threshold": 0.3,
    "min_correlation_threshold": 0.7,
    "stability_threshold": 0.6,
    "step3_target_retention": 0.6,
    "step4_target_retention": 0.5,
    "n_bootstrap": 100,
    "calibrate_probabilities": false,
    "enable_nested_cv": false,
    "outer_cv_splits": 5,
    "step2_target_retention": 0.6
}
